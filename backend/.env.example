PROJECT_NAME="VeriFA AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt"
ENCRYPTION_KEY="generate-a-valid-fernet-key-32-url-safe-base64"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for immediate local dev, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./verifa.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/verifa"

# Hugging Face Models
HHEM_MODEL_NAME="vectara/hallucination_evaluation_model"
DEVICE="auto"

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
REQUEST_TIMEOUT_SECONDS=30
MAX_RESPONSE_SIZE_BYTES=5242880
